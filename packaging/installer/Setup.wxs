<!--
  Setup.exe for Room AC Control: a WiX bundle that installs the same per-user
  MSI with a simpler window and a Launch button. No administrator rights.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="Room AC Control for hOn"
          Manufacturer="Room AC Control contributors"
          Version="$(var.Version)"
          UpgradeCode="3CE84886-4F75-40A5-B136-E82F9D22EA78"
          IconSourceFile="$(var.Icon)"
          AboutUrl="https://github.com/LuisBadal0/room-ac-control-hon"
          HelpUrl="https://github.com/LuisBadal0/room-ac-control-hon/blob/main/docs/USER_GUIDE.md"
          UpdateUrl="https://github.com/LuisBadal0/room-ac-control-hon/releases/latest">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="hyperlinkLicense"
          LicenseUrl="https://github.com/LuisBadal0/room-ac-control-hon/blob/main/LICENSE"
          LogoFile="$(var.Logo)"
          SuppressOptionsUI="yes"
          SuppressRepair="yes" />
    </BootstrapperApplication>

    <Variable Name="LaunchTarget"
              Value="[LocalAppDataFolder]Programs\Room AC Control\runtime\RoomACControl\RoomACControl.exe" />
    <Variable Name="LaunchWorkingFolder" Value="[LocalAppDataFolder]Programs\Room AC Control" />

    <Chain>
      <MsiPackage SourceFile="$(var.Msi)" />
    </Chain>
  </Bundle>
</Wix>
